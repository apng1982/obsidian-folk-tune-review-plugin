{
  "name": "obsidian-folk-tune-review-plugin",
  "version": "0.1.0",
  "description": "Mobile-first Obsidian plugin for reviewing a repertoire of folk tunes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "install-local": "node scripts/install-local.mjs"
  },
  "keywords": [
    "obsidian",
    "folk-tunes",
    "spaced-review"
  ],
  "author": "Cloud Awesome",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.8"
  }
}
